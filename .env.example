# Airtable
# Required for the main production flow: Airtable -> Document URL -> Telegram
AIRTABLE_TOKEN=your_airtable_token_here

# Telegram
# Required if you want the bot to send the final report link
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# OpenAI
# Optional. Needed only for LLM enrichment of ideas, headlines, and recommendations.
OPENAI_API_KEY=your_openai_api_key_here

# Slack
# Optional. If set, the project can also send a notification to Slack.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
